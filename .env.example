# Base URL for the banking app (hash route to login)
BASE_URL=https://www.globalsqa.com/angularJs-protractor/BankingProject/#/login

# Browser window: omit this line for a visible browser locally (default).
# Set HEADED=false to run headless on your machine. In CI, tests run headless unless you set HEADED=true.
# HEADED=false

# Default Playwright browser: chromium | firefox | webkit (webkit = Safari engine)
BROWSER=firefox

# Optional slow motion (ms) for debugging
SLOW_MO=0

# Allure results path is set in cucumber.json (formatOptions.resultsDir)
